# Doxyfile configuration for Doxygen
PROJECT_NAME           = "Ejemplo Python Flask"
OUTPUT_DIRECTORY       = "docs"
RECURSIVE              = YES
GENERATE_LATEX         = NO

# Ajustes adicionales para proyectos Python
INPUT                  = .
FILE_PATTERNS          = *.py
EXCLUDE                = venv docs
EXTRACT_ALL            = YES
OPTIMIZE_OUTPUT_JAVA   = YES
GENERATE_HTML          = YES
OUTPUT_LANGUAGE        = Spanish

# Advertencias de documentación (usadas por la etapa Check Documentation)
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_LOGFILE           = doxygen-warnings.log
